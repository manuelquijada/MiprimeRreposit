Algoritmo Ejercicio7MultiplicacionyDivicion
	
	Definir numero1, numero2, multiplicacion, divicion Como Entero
	
	Escribir  "ingrese el primero numero "
	Leer numero1
	
	Escribir "ingrese el numero 2"
	Leer numero2
	
	multiplicacion <- numero1 * numero2
	Escribir "el producto es: ", multiplicacion
	
	divicion <- numero1 / numero2
	Escribir " el cociente es: ", divicion
	
FinAlgoritmo
